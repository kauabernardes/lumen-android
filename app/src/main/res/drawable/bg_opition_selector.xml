<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_checkin_icon_bg" />
            <stroke android:width="2dp" android:color="@color/card_checkin_text" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_checkin_background" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_checkin_icon_bg" />
            <stroke android:width="1.5dp" android:color="@color/card_checkin_background" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>