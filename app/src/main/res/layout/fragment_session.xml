<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/session_theme_background"
    tools:context=".ui.SessionFragment">

    <include
        android:id="@+id/header_component"
        layout="@layout/layout_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/task_title"
        style="@style/TextAppearance.MaterialComponents.Headline4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:text="@string/tarefa"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toBottomOf="@+id/header_component"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/linear_task"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/task_title"></LinearLayout>

    <ImageView
        android:id="@+id/icon_session_title"
        android:layout_width="45dp"
        android:layout_height="45dp"

        app:layout_constraintTop_toBottomOf="@id/linear_task"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/ic_clock"

        />

    <TextView
        android:id="@+id/session_title"
        style="@style/TextAppearance.MaterialComponents.Headline4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:text="@string/session_title"
        android:textColor="@color/card_session_text"

        android:layout_marginStart="8dp"

        app:layout_constraintTop_toTopOf="@id/icon_session_title"
        app:layout_constraintBottom_toBottomOf="@id/icon_session_title"
        app:layout_constraintStart_toEndOf="@id/icon_session_title"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_timer"

        android:layout_width="0dp"
        android:layout_height="100dp"


        app:cardBackgroundColor="@color/session_theme_foreground"
        app:cardCornerRadius="25dp"

        app:cardElevation="0dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/icon_session_title"

        android:layout_marginTop="16dp"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_study"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_session_study"
        android:textSize="16sp"
        app:icon="@drawable/ic_book"
        android:backgroundTint="@color/session_high"

        app:layout_constraintStart_toStartOf="@id/card_timer"
        app:layout_constraintEnd_toStartOf="@+id/btn_short_break"
        app:layout_constraintTop_toTopOf="@id/card_timer"

        android:layout_marginEnd="4dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_short_break"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_session_short_break"
        android:textSize="16sp"
        app:icon="@drawable/ic_coffee"
        android:backgroundTint="@color/session_high"

        app:layout_constraintStart_toEndOf="@+id/btn_study"
        app:layout_constraintEnd_toStartOf="@+id/btn_long_break"
        app:layout_constraintTop_toTopOf="@id/card_timer"

        android:layout_marginHorizontal="4dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_long_break"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_session_long_break"
        android:textSize="16sp"
        app:icon="@drawable/ic_coffee"
        android:backgroundTint="@color/session_high"

        app:layout_constraintStart_toEndOf="@+id/btn_short_break"
        app:layout_constraintEnd_toEndOf="@id/card_timer"
        app:layout_constraintTop_toTopOf="@id/card_timer"

        android:layout_marginStart="4dp" />

</androidx.constraintlayout.widget.ConstraintLayout>