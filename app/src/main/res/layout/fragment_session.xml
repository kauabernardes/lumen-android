<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/session_theme_background"
    tools:context=".ui.SessionFragment">

    <ImageView
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/ic_chevron_left"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/avatar"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/dog"
        android:scaleType="centerCrop"
        android:contentDescription="@string/desc_avatar_usuario"
        app:shapeAppearance="@style/circleImageView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/task_title"
        style="@style/TextAppearance.MaterialComponents.Headline4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:text="@string/tarefa"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toBottomOf="@+id/avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/linear_task"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/task_title"></LinearLayout>

    <ImageView
        android:id="@+id/icon_session_title"
        android:layout_width="45dp"
        android:layout_height="45dp"

        app:layout_constraintTop_toBottomOf="@id/linear_task"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/clock"

        />

    <TextView
        android:id="@+id/session_title"
        style="@style/TextAppearance.MaterialComponents.Headline4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:text="@string/session_title"
        android:textColor="@color/card_session_text"

        android:layout_marginStart="8dp"

        app:layout_constraintTop_toTopOf="@id/icon_session_title"
        app:layout_constraintBottom_toBottomOf="@id/icon_session_title"
        app:layout_constraintStart_toEndOf="@id/icon_session_title"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="100dp"


        app:cardBackgroundColor="@color/session_theme_foreground"
        app:cardCornerRadius="25dp"

        app:cardElevation="0dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/icon_session_title"

        android:layout_marginTop="16dp"/>
    

        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:textSize="18sp"
            android:text="@string/btn_session_study"
            app:layout_constraintHorizontal_weight="8"
            android:backgroundTint="@color/session_high"
            />


</androidx.constraintlayout.widget.ConstraintLayout>