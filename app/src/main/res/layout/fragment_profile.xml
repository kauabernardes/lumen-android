<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/md_theme_background"

    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.auth.ProfileFragment">


    <View


        android:id="@+id/lumen_wave"
        android:layout_width="0dp"
        android:layout_height="261dp"

        android:background="@drawable/lumen_wave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        android:layout_marginTop="-50dp"
        />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/user_icon"

        android:layout_width="142dp"
        android:layout_height="142dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"


        android:layout_marginTop="64dp"

        app:shapeAppearance="@style/circleImageView"

        android:background="@color/md_theme_foreground"
        />

    <TextView
        android:id="@+id/name"


        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="8dp"

        app:layout_constraintTop_toBottomOf="@id/user_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:text="@string/default_empty"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"

        />

    <TextView
        android:id="@+id/username"


        android:layout_width="wrap_content"
        android:layout_height="wrap_content"


        app:layout_constraintTop_toBottomOf="@id/name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"



        android:text="@string/default_empty"
        android:textSize="18sp"
        android:textColor="@color/text_secondary"

        />


    <TextView
        android:id="@+id/title_minhas_comunidades"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/username"
       android:text="@string/title_minhas_comunidades"

        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="18dp"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"

        />

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:paddingHorizontal="4dp"

        app:layout_constraintTop_toBottomOf="@id/title_minhas_comunidades"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="horizontal"
        tools:listitem="@layout/comunidade_vertical_item"

        />


</androidx.constraintlayout.widget.ConstraintLayout>