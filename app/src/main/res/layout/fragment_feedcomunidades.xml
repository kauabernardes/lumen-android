<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp">

                <ImageView
                    android:id="@+id/imgCapaComunidade"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/capafeedcomunidade"
                    android:contentDescription="Capa da comunidade" />


            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvNomeComunidade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loucos do ENEM"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvDescricaoComunidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Para quem quer enlouquecer de estudar para a prova do enemmm. Vamos juntoso ocupar as universidades"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:lineSpacingExtra="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvCriadoPor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Criado por: @mulienemm"
                        android:textSize="12sp"
                        android:textColor="#888888"
                        android:gravity="end" />

                    <TextView
                        android:id="@+id/tvDataCriacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Em 12 de março de 2025"
                        android:textSize="12sp"
                        android:textColor="#888888"
                        android:gravity="end" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/text_light" />



        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNovoPost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:src="@drawable/ic_add"
        android:contentDescription="Novo post"
        app:backgroundTint="@color/md_theme_primary"
        app:tint="@color/card_achievements_bg"
        app:elevation="6dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>