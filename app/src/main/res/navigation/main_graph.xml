<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/sessionFragment"
        android:name="org.lumen.app.ui.SessionFragment"
        android:label="fragment_session"
        tools:layout="@layout/fragment_session" />
    <fragment
        android:id="@+id/homeFragment"
        android:name="org.lumen.app.ui.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_sessionFragment"
            app:destination="@id/sessionFragment" />
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_homeFragment_pop"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_homeFragment_to_explorarFragment"
            app:destination="@id/explorarFragment" />


    </fragment>
    <fragment
        android:id="@+id/feedComunidadeFragment"
        android:name="org.lumen.app.ui.comunidade.FeedFragment"
        android:label="FeedComunidadeFragment">

        <argument
            android:name="communityId"
            app:argType="string" />
        <action
            android:id="@+id/action_feedComunidadeFragment_to_postFragment"
            app:destination="@id/postFragment"
            app:enterAnim="@anim/nav_default_enter_anim" />
        <action
            android:id="@+id/action_feedComunidadeFragment_to_criarNovoPost"
            app:destination="@id/criarNovoPost" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="org.lumen.app.ui.auth.LoginFragment"
        android:label="LoginFragment" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true"

            />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/splashFragment"
        android:name="org.lumen.app.ui.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash"


        >
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="org.lumen.app.ui.auth.RegisterFragment"
        android:label="fragment_register"
        tools:layout="@layout/fragment_register" >
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="org.lumen.app.ui.auth.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_feedComunidadeFragment"
            app:destination="@id/feedComunidadeFragment" />
        <argument
            android:name="userId"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/postFragment"
        android:name="org.lumen.app.ui.PostFragment"
        android:label="fragment_post"
        tools:layout="@layout/fragment_post" >
        <argument
            android:name="postId"
            app:argType="string" />
        <action
            android:id="@+id/action_postFragment_self"
            app:destination="@id/postFragment" />
        <action
            android:id="@+id/action_postFragment_to_feedComunidadeFragment"
            app:destination="@id/feedComunidadeFragment" />
        <action
            android:id="@+id/action_postFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>
    <fragment
        android:id="@+id/explorarFragment"
        android:name="org.lumen.app.ui.comunidade.ExplorarFragment"
        android:label="ExplorarFragment" >
        <action
            android:id="@+id/action_explorarFragment_to_feedComunidadeFragment"
            app:destination="@id/feedComunidadeFragment" />
    </fragment>
    <fragment
        android:id="@+id/criarNovoPost"
        android:name="org.lumen.app.CriarNovoPost"
        android:label="CriarNovoPost" >
        <argument
            android:name="communityId"
            app:argType="string" />
    </fragment>
    <action android:id="@+id/action_global_profileFragment" app:destination="@id/profileFragment" />
</navigation>